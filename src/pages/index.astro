---
import Layout from '../layouts/Layout.astro';
import { site } from '../site.config';
import { getCommits, getInsights, formatDate } from '../lib/content';

const commits = (await getCommits()).slice(0, 3);
const insights = (await getInsights()).slice(0, 2);
---

<Layout title="Home">
  <section class="wrap hero">
    <p class="eyebrow">{site.role}</p>
    <h1>{site.name}</h1>
    <p class="lede">{site.summary}</p>
    <div class="hero-actions">
      <a class="btn" href="/timeline">Browse the timeline</a>
      <a class="btn btn-ghost" href="/insights">Read insights</a>
    </div>
  </section>

  <section class="wrap block">
    <h2>Who I am</h2>
    <p>{site.whoIAm}</p>
  </section>

  <section class="wrap block">
    <h2>What I stand for</h2>
    <ul class="values">
      {site.whatIStandFor.map((value) => <li class="card">{value}</li>)}
    </ul>
  </section>

  <section class="wrap block">
    <div class="block-head">
      <h2>Timeline</h2>
      <a href="/timeline">View full timeline &rarr;</a>
    </div>
    <p class="text-dim">
      A Git-history-style record of projects, roles and milestones — each one is a commit,
      tagged and connected along a branch.
    </p>
    <ul class="preview-list">
      {
        commits.map((commit) => (
          <li class="card">
            <a href={`/timeline/${commit.data.id}`}>
              <span class="preview-date">{formatDate(commit.data.date)}</span>
              <span class="preview-title">{commit.data.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap block">
    <div class="block-head">
      <h2>Insights</h2>
      <a href="/insights">View all insights &rarr;</a>
    </div>
    <p class="text-dim">Short write-ups on projects, tools and lessons learned.</p>
    <ul class="preview-list">
      {
        insights.map((insight) => (
          <li class="card">
            <a href={`/insights/${insight.id}`}>
              <span class="preview-date">{formatDate(insight.data.date)}</span>
              <span class="preview-title">{insight.data.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap block">
    <h2>Elsewhere</h2>
    <div class="hero-actions">
      <a class="btn" href={site.links.github}>GitHub</a>
      <a class="btn" href={site.links.linkedin}>LinkedIn</a>
      <a class="btn" href="/contacts">My Profiles</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 4rem 1.5rem 2rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0.3rem 0 1rem;
  }
  .lede {
    max-width: 60ch;
    color: var(--text-dim);
    font-size: 1.05rem;
  }
  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .btn-ghost {
    border-color: var(--border);
    color: var(--text);
  }
  .btn-ghost:hover {
    background: var(--bg-raised);
    color: var(--text);
  }
  .block {
    padding: 2rem 1.5rem;
  }
  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .block-head a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--sub);
    text-decoration: none;
  }
  .text-dim {
    color: var(--text-dim);
  }
  .values {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .preview-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .preview-list a {
    display: flex;
    gap: 1rem;
    text-decoration: none;
    color: var(--text);
    align-items: baseline;
  }
  .preview-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .preview-title {
    font-weight: 600;
  }
</style>
